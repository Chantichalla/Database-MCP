# Database Gateway MCP - Configuration Template
# Preferred path: `python setup.py init` generates this file for you.
# Manual path: copy to .env and replace placeholders.

# Database Engine: 'postgresql' or 'sqlite'
DB_ENGINE=postgresql

# PostgreSQL Connection Parameters (gateway-managed demo stack)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=chinook
# DB_SEED: 'chinook' (expect Chinook schema) or 'empty' (your own schema;
# table-specific provisioning steps are skipped gracefully)
DB_SEED=chinook
DB_SSLMODE=prefer

# Superuser (provisioning via scripts/setup_roles.py + docker compose ONLY;
# runtime code never uses this)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_before_any_shared_use

# Legacy service accounts (circuit-breaker service identity + compat)
DB_USER=agent_ro
DB_PASSWORD=change_me_agent_ro
DB_MUTATION_USER=agent_rw
DB_MUTATION_PASSWORD=change_me_agent_rw
# DATABASE_URL=postgresql://agent_ro:change_me_agent_ro@127.0.0.1:5433/chinook
# DB_MUTATION_URL=postgresql://agent_rw:change_me_agent_rw@127.0.0.1:5433/chinook

# Keycard for THIS deployment (reader|editor|admin, see roles.yaml).
# This is the whole-deployment access level until changed + restarted.
GATEWAY_ROLE=reader
GATEWAY_READER_PASSWORD=change_me_reader
GATEWAY_EDITOR_PASSWORD=change_me_editor
GATEWAY_ADMIN_PASSWORD=change_me_admin

# Human-in-the-loop approval key (operator-only; the LLM must never see this)
OPERATOR_APPROVAL_SECRET=change_me_operator_key

# Guardrail & Safety Execution Thresholds
DB_MAX_ROWS=100
DB_TIMEOUT_SECONDS=2.0
DB_MAX_PAYLOAD_BYTES=524288
